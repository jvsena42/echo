<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Launch theme. The window the system draws before MainActivity exists: Loopky's cream
      surface with the fox on a soft-accent circle, which is exactly how the branded splash
      Compose draws next looks — so the handoff between them is invisible.
    -->
    <style name="Theme.Loopky.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand_surface</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_accent_soft</item>
        <item name="postSplashScreenTheme">@style/Theme.Loopky</item>
    </style>

    <style name="Theme.Loopky" parent="@android:style/Theme.Material.Light.NoActionBar" />
</resources>
